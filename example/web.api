		Location     Location `json:"location,optional"`
		Radius       float64  `json:"radius,default=100000"`
		LanguageCode string   `json:"languageCode,default=en" validate:"bcp47_language_tag"`
	}
	NavitimeMapSearchResp {
		Items []Item `json:"items"`
		Unit  Unit   `json:"unit"`
	}
	Item {
		Code       string   `json:"code"`
		Name       string   `json:"name"`
		PostalCode string   `json:"postal_code"`
		Coord      Coord    `json:"coord"`
		Details    []Detail `json:"details"`
		IsEnd      bool     `json:"is_end"`
	}
	Coord {
		Lat float64 `json:"lat"`
		Lon float64 `json:"lon"`
	}
	Detail {
		Code  string `json:"code"`
		Name  string `json:"name"`
		Ruby  string `json:"ruby"`
		Level string `json:"level"`
	}
	Unit {
		Datum     string `json:"datum"`
		CoordUnit string `json:"coord_unit"`
	}
)

@server (
	prefix: /v1/custom/navitime/maps
	group:  navitime_maps
)
service web-api {
	@handler NavitimeMapSearchHandler
	post /search (NavitimeMapSearchReq) returns (NavitimeMapSearchResp)
}

