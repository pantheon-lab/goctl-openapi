		UpdatedAt       int64                  `json:"updatedAt"`
		SessionId       string                 `json:"sessionId"`
		ProfileId       string                 `json:"profileId"`
		Role            string                 `json:"role"`
		Credit          int32                  `json:"credit"`
		RequestId       string                 `json:"requestId,omitempty"`
		DisplayText     []MediaText            `json:"displayText"`
		DisplayTextHash string                 `json:"displayTextHash,omitempty"`
		VoiceText       []MediaText            `json:"voiceText"`
		VoiceTextHash   string                 `json:"voiceTextHash,omitempty"`
		Media           []MediaMedia           `json:"media"`
		AudioUrl        string                 `json:"audioUrl,omitempty"`
		VideoUrl        string                 `json:"videoUrl,omitempty"`
		Details         map[string]interface{} `json:"details"`
		AudioStatus     string                 `json:"audioStatus,omitempty"`
		VideoStatus     string                 `json:"videoStatus,omitempty"`
		ClientId        string                 `json:"clientId"`
	}
