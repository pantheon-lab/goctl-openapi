	}
	ChatMessageNewEntryReq {
		ApiKey       string                 `header:"x-api-key"`
		SessionId    string                 `json:"session_id"`
		TextContent  string                 `json:"text_content,optional"`
		Query        string                 `json:"query,optional"`
		LanguageCode string                 `json:"language_code"`
		Role         string                 `json:"role,default=user"`
		Metadata     map[string]interface{} `json:"metadata,optional"`
		VideoUrl     string                 `json:"video_url,optional"`
		Gesture      string                 `json:"gesture,default=default"`
		FlowName     *string                `json:"flow_name,optional"`
		PageName     *string                `json:"page_name,optional"`
		IntentName   *string                `json:"intent_name,optional"`
	}
	ChatMessage {
		Id          string                 `json:"id"`
		CreatedAt   int64                  `json:"createdAt"`
		UpdatedAt   int64                  `json:"updatedAt"`
		SessionId   string                 `json:"sessionId"`
		ProfileId   string                 `json:"profileId"`
		Role        string                 `json:"role"`
		Credit      int32                  `json:"credit"`
		DisplayText []MediaText            `json:"displayText"`
		Media       []MediaMedia           `json:"media"`
		VideoBucket string                 `json:"videoBucket,omitempty"`
		VideoPath   string                 `json:"videoPath,omitempty"`
		VideoUrl    string                 `json:"videoUrl,omitempty"`
		Details     map[string]interface{} `json:"details,omitempty"`
	}
	ChatMessageNewEntryResp {
		Success bool         `json:"success"`
		Message *ChatMessage `json:"message"`
	}
