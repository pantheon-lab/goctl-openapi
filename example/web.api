/////////////
// General //
/////////////
@server (
	prefix: /v1
	group:  general
)
service web-api {
	@handler PingHandler
	get /health
}

// Render
type RenderRequest {
	Id              string `json:"id"`
	CreatedAt       int64  `json:"created_at"`
	UpdatedAt       int64  `json:"updated_at"`
	RefId           string `json:"ref_id"`
	SessionId       string `json:"session_id,optional"`
	MessageId       string `json:"message_id,optional"`
	DisplayText     string `json:"display_text,optional"`
	DisplayTextHash string `json:"display_text_hash,optional"`
	VoiceText       string `json:"voice_text,optional"`
	VoiceTextHash   string `json:"voice_text_hash,optional"`
	ProfileId       string `json:"profile_id"`
	AudioPath       string `json:"audio_path,optional"`
	AudioUrl        string `json:"audio_url,optional"`
	AudioStartAt    int64  `json:"audio_start_at,optional"`
	AudioFinishAt   int64  `json:"audio_finish_at,optional"`
	AudioStatus     string `json:"audio_status"`
	VideoPath       string `json:"video_path,optional"`
	VideoUrl        string `json:"video_url,optional"`
	VideoStartAt    int64  `json:"video_start_at,optional"`
	VideoFinishAt   int64  `json:"video_finish_at,optional"`
	VideoStatus     string `json:"video_status"`
	RequestStartAt  int64  `json:"request_start_at,optional"`
	RequestFinishAt int64  `json:"request_finish_at,optional"`
	RequestStatus   string `json:"request_status"`
	Message         string `json:"message,optional"`
}

type NewRenderRequest {
	RefId           string `json:"ref_id,optional"`
	ProfileId       string `json:"profile_id,optional"`
	Token           string `json:"token,optional"`
	TextContent     string `json:"text_content"`
	LanguageCode    string `json:"language_code"`
	SkipAudioRender bool   `json:"skipAudioRender,default=false"`
	SkipVideoRender bool   `json:"skipVideoRender,default=false"`
	Gesture         string `json:"gesture,optional"`
}

type NewFlexibleRequest {
	VoiceId               string  `json:"voice_id"`
	VoiceSpeed            string  `json:"voice_speed,optional"`
	VoicePitch            string  `json:"voice_pitch,optional"`
	ModelId               string  `json:"model_id"`
	ModelGestureStartTime float32 `json:"model_gesture_start_time,optional"`
	Token                 string  `json:"token,optional"`
	ProfileId             string  `json:"profile_id,optional"`
	TextContent           string  `json:"text_content"`
	VoiceLanguageCode     string  `json:"voice_language_code"`
	Gesture               string  `json:"gesture,optional"`
	Provider              string  `json:"provider"`
}

type GetStationAvatarReq {
	StationName string `json:"stationName"`
	Lang        string `json:"lang"`
}

type GetStationAvatarResp {
	Token     string `json:"token"`
	ModelKey  string `json:"model_key"`
	ProfileId string `json:"profile_id"`
}

type AvatarAction {
	ModelId string   `json:"model_id"`
	Actions []string `json:"actions"`
}

type AvatarActions {
	Data []AvatarAction `json:"data"`
}

type DialogFlowReq {
	SessionInfo  SessionInfo `json:"sessionInfo"`
	LanguageCode string      `json:"languageCode"`
}

type SessionInfo {
	Session    string                 `json:"session"`
	Parameters map[string]interface{} `json:"parameters"`
}

type FulfillmentMessage {
	Payload map[string]interface{} `json:"payload"`
}

type FulfillmentResponse {
	Messages []FulfillmentMessage `json:"message,omitempty"`
}

type DialogFlowSignalParms {
	Signal string `json:"signal"`
}

type DialogFlowRespPayloadMedia {
	Type   string                `json:"type"`
	Url    string                `json:"url,omitempty"`
	Params DialogFlowSignalParms `json:"params,omitempty"`
}

type DialogFlowRespPayload {
	Media   []DialogFlowRespPayloadMedia `json:"media"`
	Details map[string]interface{}       `json:"details"`
}

type DialogFlowResp {
	FulfillmentResponse FulfillmentResponse   `json:"fulfillmentResponse"`
	SessionInfo         SessionInfo           `json:"sessionInfo"`
	Payload             DialogFlowRespPayload `json:"payload"`
}

@server (
	prefix: /v1/render
	group:  render
)
service web-api {
	// @handler GetRequestsHandler
	// get /requests returns ([]RenderRequest)
	@handler NewRequestHandler
	post /new_request (NewRenderRequest) returns (RenderRequest)

	@handler GetStationAvatarHandler
	post /get_station_avatar (GetStationAvatarReq) returns (GetStationAvatarResp)

	@handler UpsertAvatarActions
	post /upsert_avatar_actions (AvatarActions) returns (AvatarActions)

	@handler NewFlexibleRequestHandler
	post /new_flexible_request (NewFlexibleRequest) returns (RenderRequest)
}

@server (
	prefix:  /v1/render
	group:   render
	timeout: 0
)
service web-api {
	@handler NewRequestStreamHandler
	post /new_request/stream (NewRenderRequest)

	@handler NewFlexibleRequestStreamHandler
	post /new_flexible_request/stream (NewFlexibleRequest)
}

// Profile
type (
	Config {
		Id           string                 `json:"id"`
		CreatedAt    int64                  `json:"created_at"`
		UpdatedAt    int64                  `json:"updated_at"`
		LanguageCode string                 `json:"language_code"`
		Name         string                 `json:"name"`
		Details      map[string]interface{} `json:"details"`
		Enabled      bool                   `json:"enabled"`
	}
	Channel {
		Id             string                 `json:"id"`
		CreatedAt      int64                  `json:"created_at"`
		UpdatedAt      int64                  `json:"updated_at"`
		LanguageCode   string                 `json:"language_code"`
		LanguageConfig Config                 `json:"language_config"`
		BotConfig      Config                 `json:"bot_config"`
		VoiceConfig    Config                 `json:"voice_config"`
		ModelConfig    Config                 `json:"model_config"`
		GeneralConfig  Config                 `json:"general_config"`
		Name           string                 `json:"name"`
		Details        map[string]interface{} `json:"details"`
		IsDefault      bool                   `json:"is_default"`
		Enabled        bool                   `json:"enabled"`
	}
	GetChannelReq {
		ProfileId    string `json:"profile_id,optional"`
		ChannelId    string `json:"channel_id,optional"`
		LanguageCode string `json:"language_code,optional"`
	}
	ModelAction {
		ModelId string   `json:"model_id"`
		Actions []string `json:"actions"`
		Gender  *string  `json:"gender,optional"`
	}
	ListModelActionsReq {
		UseEmbedded bool `form:"use_embedded,default=false"`
	}
	ListModelActionsResp {
		Nodes []ModelAction `json:"data"`
	}
)

@server (
	prefix: /v1/profile
	group:  profile
	jwt:    Auth // Enable JWT authentication
)
service web-api {
	@handler GetChannelHandler
	post /get_channel (GetChannelReq) returns (Channel)

	@handler ListModelActionsHandler
	get /list_model_actions (ListModelActionsReq) returns (ListModelActionsResp)
}

// User
type UserCredit {
	Used  int32 `json:"used"`
	Total int32 `json:"total"`
}

type (
	UserDataReq {
		Token string `header:"Authorization"`
	}
	UserProfile {
		ProfileId  string                 `json:"profile_id"`
		Name       string                 `json:"name"` // from profile table
		Details    map[string]interface{} `json:"details"` // from profile table
		Permission string                 `json:"permission"`
		IsActive   bool                   `json:"is_active"`
	}
	UserData {
		Id         string        `json:"id"`
		Email      string        `json:"email"`
		Name       string        `json:"name"`
		Locale     string        `json:"locale"`
		IsActive   bool          `json:"is_active"`
		IsVerified bool          `json:"is_verified"`
		Profiles   []UserProfile `json:"profiles"`
	}
)

@server (
	prefix: /v1/user
	group:  user
	jwt:    Auth // Enable JWT authentication
)
service web-api {
	@handler GetUserDataHandler
	get /data (UserDataReq) returns (UserData)
}

// @server(
//  prefix: /v1
//  group: user
// )
// service web-api {
//  @handler GetUserCreditHandler
//  get /user/credit returns (UserCredit)
// }
//////////////////////////
// User (OAuth related) //
//////////////////////////
type (
	RefreshTokenReq {
		RefreshToken string `json:"refreshToken"`
	}
	RefreshTokenResp {
		Token string `json:"token"`
	}
	SignInDto {
		Email        string `json:"email"`
		Password     string `json:"password" mask:"hash"`
		ProfileId    string `json:"profileId,optional"`
		OriginHeader string `header:"Origin,optional"`
		SubPath      string `json:"subpath,optional"`
	}
	OrgRoleStatus {
		Role   string `json:"role"`
		Status string `json:"status"`
		Name   string `json:"orgName"`
		Id     string `json:"orgId"`
	}
	SignInRes {
		Url          string          `json:"url"`
		Token        string          `json:"token"`
		RefreshToken string          `json:"refreshToken"`
		Id           string          `json:"id"`
		Email        string          `json:"email"`
		Name         string          `json:"name"`
		Role         string          `json:"role"`
		OrgRole      []OrgRoleStatus `json:"orgRole"`
		IsActive     bool            `json:"isActive"`
		IsVerified   bool            `json:"isVerified"`
	}
	SignUpDto {
		Email    string `json:"email"`
		Password string `json:"password"`
		Name     string `json:"name"`
	}
	SignUpRes {
		Id    string `json:"id"`
		Email string `json:"email"`
		Name  string `json:"name"`
	}
	AuthorizedReq {
		Code  string `form:"code"`
		State string `form:"state"`
	}
	OauthShopifyReq {
		Shop string `form:"shop"`
	}
	ShopifyAuthorizedReq {
		Code string `form:"code"`
		Hmac string `form:"hmac"`
		Shop string `form:"shop"`
	}
	OauthRequest {
		Redirect string `form:"redirect,optional"`
	}
)

@server (
	prefix: /v1/oauth
	group:  auth
)
service web-api {
	@handler OauthGoogleRequestHandler
	get /google (OauthRequest)

	@handler OauthGoogleAuthorizedRequestHandler
	get /google/authorized (AuthorizedReq)

	@handler OauthGoogleFailRequestHandler
	get /google/fail

	@handler OauthGithubRequestHandler
	get /github (OauthRequest)

	@handler OauthGithubAuthorizedRequestHandler
	get /github/authorized (AuthorizedReq)

	@handler OauthGithubFailRequestHandler
	get /github/fail

	@handler OauthShopifyRequestHandler
	get /shopify (OauthShopifyReq)

	@handler OauthShopifyAuthorizedRequestHandler
	get /shopify/authorized (ShopifyAuthorizedReq)

	@handler SignUpRequestHandler
	post /signup (SignUpDto) returns (SignUpRes)

	@handler SignInRequestHandler
	post /signin (SignInDto) returns (SignInRes)

	@handler RefreshTokenRequestHandler
	post /refresh_token (RefreshTokenReq) returns (RefreshTokenResp)
}

/////////////////
// File upload //
/////////////////
type (
	UploadReq {
		File string `form:"file,optional"`
		Path string `form:"path,optional"`
	}
	UploadResp {
		Msg     string `json:"msg"`
		Url     string `json:"url"`
		FullUrl string `json:"full_url"`
	}
)

@server (
	prefix: /v1/upload
	group:  upload
)
service web-api {
	@handler UploadHandler
	post / (UploadReq) returns (UploadResp)

	@handler UploadChatAgentMediaHandler
	post /media (UploadReq) returns (UploadResp)
}

///////////////////////
// Webhook - Setsail //
///////////////////////
type (
	IDDto {
		Id string `json:"id"`
	}
	QuickReplyDto {
		ContentType string `json:"content_type"`
		Title       string `json:"title"`
		Payload     string `json:"payload"`
	}
	ButtonDto {
		Title   string `json:"title,optional"`
		Type    string `json:"type"`
		Payload string `json:"payload,optional"`
		Url     string `json:"url,optional"`
	}
	PayloadDto {
		TemplateType string      `json:"template_type"`
		Text         string      `json:"text"`
		Buttons      []ButtonDto `json:"buttons"`
	}
	AttachmentDto {
		Type    string     `json:"type"`
		Payload PayloadDto `json:"payload"`
	}
	PoiDto {
		ID                    int    `json:"ID,optional"`
		Type                  string `json:"type,optional"`
		Name                  string `json:"name,optional"`
		OriginName            string `json:"originName,optional"`
		OriginStationID       int    `json:"originStationID,optional"`
		StationName           string `json:"stationName,optional"`
		StationID             int    `json:"stationID,optional"`
		StationExit           string `json:"stationExit,optional"`
		StationExitCoordinate string `json:"stationExitCoordinate,optional"`
		Coordinate            string `json:"coordinate,optional"`
		Address               string `json:"address,optional"`
		IsSignage             bool   `json:"isSignage,optional"`
	}
	HRRouteMessageDto {
		Msg       string `json:"msg,optional"`
		Banner    int    `json:"banner,optional"`
		BgColor   string `json:"bgColor,optional"`
		URL       string `json:"url,optional"`
		Urlm      string `json:"urlm,optional"`
		FontSize  int    `json:"fontSize,optional"`
		FontColor string `json:"fontColor,optional"`
		MsgText   string `json:"msgText,optional"`
	}
	HRRouteMessageFareClassDto {
		OctopusAdult             string `json:"octopusAdult,optional"`
		OctopusConcession        string `json:"octopusConcession,optional"`
		OctopusConcessionChild   string `json:"octopusConcessionChild,optional"`
		OctopusConcessionElderly string `json:"octopusConcessionElderly,optional"`
		OctopusJoyYouSixty       string `json:"octopusJoyYouSixty,optional"`
		OctopusConcessionPwd     string `json:"octopusConcessionPwd,optional"`
		OctopusStudent           string `json:"octopusStudent,optional"`
		SjAdult                  string `json:"sjAdult,optional"`
		SjConcession             string `json:"sjConcession,optional"`
		SjConcessionChild        string `json:"sjConcessionChild,optional"`
		SjConcessionElderly      string `json:"sjConcessionElderly,optional"`
		SjConcessionPwd          string `json:"sjConcessionPwd,optional"`
		SjStudent                string `json:"sjStudent,optional"`
	}
	HRRouteMessageFareDto {
		AEL           HRRouteMessageFareClassDto `json:"AEL,optional"`
		StandardClass HRRouteMessageFareClassDto `json:"standardClass,optional"`
		FirstClass    HRRouteMessageFareClassDto `json:"firstClass,optional"`
	}
	HRRoutePathDto {
		ID            int    `json:"ID,optional"`
		StationStatus int    `json:"stationStatus,optional"`
		LinkStatus    int    `json:"linkStatus,optional"`
		LineID        int    `json:"lineID,optional"`
		DummyLine     int    `json:"DummyLine,optional"`
		Track         int    `json:"Track,optional"`
		LinkType      string `json:"linkType,optional"`
		Time          string `json:"time,optional"`
		Platform      string `json:"platform,optional"`
		Towards       string `json:"towards,optional"`
		LinkText      string `json:"linkText,optional"`
	}
	PromotionDto {
		Title    string `json:"title,optional"`
		Link     string `json:"link,optional"`
		Discount string `json:"discount,optional"`
	}
	HRRouteDto {
		Time                  float32               `json:"time,optional"`
		RouteStatus           []string              `json:"routeStatus,optional"`
		Special               int                   `json:"special,optional"`
		Feature               []string              `json:"feature,optional"`
		Rules                 string                `json:"rules,optional"`
		RouteName             string                `json:"routeName,optional"`
		InterchangeStationsNo int                   `json:"interchangeStationsNo,optional"`
		WalkingTime           float32               `json:"walkingTime,optional"`
		RouteRemark           string                `json:"routeRemark,optional"`
		Promotions            []PromotionDto        `json:"promotions,optional"`
		Messages              []HRRouteMessageDto   `json:"messages,optional"`
		Fares                 HRRouteMessageFareDto `json:"fares,optional"`
		Path                  []HRRoutePathDto      `json:"path,optional"`
	}
	LRRoutePathStepDto {
		LineID             string `json:"lineID,optional"`
		Towards            string `json:"towards,optional"`
		Platform           string `json:"platform,optional"`
		LinkText           string `json:"linkText,optional"`
		TowardsStationName string `json:"towardsStationName,optional"`
		Track              string `json:"track,optional"`
	}
	LRRoutePathDto {
		ID       string               `json:"ID,optional"`
		LinkType string               `json:"linkType,optional"`
		Time     string               `json:"time,optional"`
		Step     []LRRoutePathStepDto `json:"step,optional"`
	}
	LRRouteDto {
		Time                  string           `json:"time,optional"`
		RouteName             string           `json:"routeName,optional"`
		InterchangeStationsNo int              `json:"interchangeStationsNo,optional"`
		Path                  []LRRoutePathDto `json:"path,optional"`
	}
	CompleteRoutePathDto {
		Label      string `json:"label,optional"`
		Coordinate string `json:"coordinate,optional"`
		StopType   string `json:"stopType,optional"`
		RouteType  string `json:"routeType,optional"`
		RouteText  string `json:"routeText,optional"`
		SRouteText string `json:"sRouteText,optional"`
		Exit       string `json:"exit,optional"`
		Time       string `json:"time,optional"`
		URL        string `json:"url,optional"`
	}
	CompleteRouteDto {
		Time        string                 `json:"time,optional"`
		WalkingTime string                 `json:"walkingTime,optional"`
		Fare        string                 `json:"fare,optional"`
		RouteRemark string                 `json:"routeRemark,optional"`
		Info        string                 `json:"info,optional"`
		Promotions  []string               `json:"promotions,optional"`
		Path        []CompleteRoutePathDto `json:"path,optional"`
	}
	RouteDto {
		Poi           PoiDto           `json:"Poi,optional"`
		HRRoute       HRRouteDto       `json:"HRRoute,optional"`
		LRRoute       LRRouteDto       `json:"LRRoute,optional"`
		CompleteRoute CompleteRouteDto `json:"CompleteRoute,optional"`
	}
	CarouselLocationUnitNameDto {
		Language        string `json:"language,optional"`
		Name            string `json:"name,optional"`
		ExitDescription string `json:"exitDescription,optional"`
	}
	CarouselLocationUnitDto {
		ID    string                        `json:"id,optional"`
		Names []CarouselLocationUnitNameDto `json:"names,optional"`
		Poiid string                        `json:"poiid,optional"`
	}
	CarouselLocationDto {
		Name string                  `json:"name,optional"`
		Unit CarouselLocationUnitDto `json:"unit,optional"`
	}
	CarouselDetailDto {
		Lang     string   `json:"lang,optional"`
		ShopName string   `json:"shopName,optional"`
		Contact  string   `json:"contact,optional"`
		Tags     []string `json:"tags,optional"`
		Keywords string   `json:"keywords,optional"`
	}
	CarouselDto {
		Id        string                `json:"id,optional"`
		DocId     string                `json:"docId,optional"`
		Type      string                `json:"type,optional"`
		Logo      string                `json:"logo,optional"`
		Image     string                `json:"image,optional"`
		Locations []CarouselLocationDto `json:"locations,optional"`
		Details   []CarouselDetailDto   `json:"details,optional"`
	}
	MessagePayloadDto {
		IntentSurveyText         string          `json:"intent_survey_text,optional"`
		IntentSurveyQuickReplies []QuickReplyDto `json:"intent_survey_quick_replies,optional"`
	}
	MessageDto {
		Text              string            `json:"text,optional"`
		Gesture           string            `json:"gesture,optional"`
		Type              string            `json:"type,optional"`
		Html              string            `json:"html,optional"`
		CallCenter        string            `json:"callCenter,optional"`
		Image             string            `json:"image,optional"`
		Query             string            `json:"query,optional"`
		AgentBackgroundZh string            `json:"agent_background_zh,optional"`
		AgentBackfroundEn string            `json:"agent_background_en,optional"`
		FallbackMessage   string            `json:"fallback_message,optional"`
		ProjectId         string            `json:"project_id,optional"`
		ButtonConfirmText string            `json:"button_confirm_text,optional"`
		ButtonCancelText  string            `json:"button_cancel_text,optional"`
		SkipLipSync       bool              `json:"skipLipSync,optional"`
		Carousel          []CarouselDto     `json:"carousel,optional"`
		Route             RouteDto          `json:"route,optional"`
		QuickReplies      []QuickReplyDto   `json:"quick_replies,optional"`
		Attachment        AttachmentDto     `json:"attachment,optional"`
		Action            string            `json:"action,optional"`
		Payload           MessagePayloadDto `json:"payload,optional"`
	}
	DetailsDto {
		OutgoingMid    string `json:"outgoing_mid"`
		Lang           string `json:"lang"`
		Intent         string `json:"intent,optional"`
		ConfidenceTier string `json:"confidence_tier,optional"`
	}
	SetsailChatResponseDto {
		Timestamp int64      `json:"timestamp"`
		ChatbotId string     `json:"chatbot_id"`
		Recipient IDDto      `json:"recipient"`
		Sender    IDDto      `json:"sender"`
		Message   MessageDto `json:"message"`
		Details   DetailsDto `json:"details"`
	}
	SetsailUpdateStationProfileReq {
		Token       string `json:"token"`
		StationName string `json:"stationName"`
		Lang        string `json:"lang"`
	}
	SetsailUpdateStationProfileResp {
		Success bool   `json:"success"`
		Message string `json:"message"`
	}
)

@server (
	prefix: /v1/webhook
	group:  webhook
)
service web-api {
	@handler SetsailChatResponseHandler
	post /setsail (SetsailChatResponseDto)

	@handler SetsailUpdateStationProfileHandler
	post /setsail/update (SetsailUpdateStationProfileReq) returns (SetsailUpdateStationProfileResp)
}

type (
	Catalog {
		Id             string                 `json:"id"`
		CreatedAt      int64                  `json:"created_at"`
		UpdatedAt      int64                  `json:"updated_at"`
		Title          string                 `json:"title"`
		FileBucket     string                 `json:"file_bucket"`
		FilePath       string                 `json:"file_path"`
		Paragraph      string                 `json:"paragraph"`
		Trigger        string                 `json:"trigger"`
		Priority       int32                  `json:"priority"`
		IsPublished    bool                   `json:"is_published"`
		PublishedAt    int64                  `json:"published_at"`
		OrganizationId string                 `json:"organization_id"`
		Tag            string                 `json:"tag"`
		TagColor       string                 `json:"tag_color"`
		Details        map[string]interface{} `json:"details"`
		CardTitle      string                 `json:"card_title"`
		Type           string                 `json:"type"`
		FileUrl        string                 `json:"file_url"`
		PromotionUrl   string                 `json:"promotion_url"`
	}
	GetGetCatalogListReq {
		Page  int32 `form:"page"`
		Limit int32 `form:"limit"`
	}
	GetCatalogListReq {
		Page  int32 `json:"page"`
		Limit int32 `json:"limit"`
	}
	GetCatalogListResp {
		Nodes []Catalog `json:"nodes"`
	}
	CatalogClickTransaction {
		Id           string `json:"id"`
		CreatedAt    int64  `json:"created_at"`
		UpdatedAt    int64  `json:"updated_at"`
		CatalogId    string `json:"catalog_id"`
		LanguageCode string `json:"language_code"`
		UserAgent    string `json:"user_agent"`
	}
	NewCatalogClickTransactionReq {
		CatalogId    string `json:"catalog_id"`
		LanguageCode string `json:"language_code"`
	}
)

@server (
	prefix:     /v1/catalog
	group:      catalog
	middleware: APIKeyAuthHeaderMiddleware,CacheMiddleware
)
service web-api {
	@handler GetGetCatalogListHandler
	get /active (GetGetCatalogListReq) returns (GetCatalogListResp)

	@handler GetCatalogListHandler
	post /active (GetCatalogListReq) returns (GetCatalogListResp)

	@handler NewCatalogClickTransactionHandler
	post /click (NewCatalogClickTransactionReq) returns (CatalogClickTransaction)
}

type (
	ProjectKioskConfig {
		Id           string `json:"id"`
		CreatedAt    int64  `json:"created_at"`
		UpdatedAt    int64  `json:"updated_at"`
		Project      string `json:"project"`
		KioskId      string `json:"kioskId"`
		LanguageCode string `json:"language_code"`
		Token        string `json:"token"`
		ProfileId    string `json:"profileId"`
		ProfileName  string `json:"profileName"`
		Enabled      bool   `json:"enabled"`
	}
	GetProjectKioskConfigReq {
		Project string `path:"project"`
		KioskId string `path:"kioskId,optional"`
	}
	GetProjectKioskConfigResp {
		Nodes   []ProjectKioskConfig `json:"nodes"`
		Success bool                 `json:"success"`
		Message string               `json:"message"`
	}
	GetProjectKioskConfigByKioskResp {
		Nodes   ProjectKioskConfig `json:"node"`
		Success bool               `json:"success"`
		Message string             `json:"message"`
	}
	UpdateProjectKioskConfigReq {
		Project      string `path:"project"`
		KioskId      string `path:"kioskId"`
		Token        string `json:"token"`
		LanguageCode string `json:"language_code,optional"`
		Enabled      bool   `json:"enabled,optional,default=true"`
	}
	UpdateProjectKioskConfigResp {
		Data    ProjectKioskConfig `json:"data"`
		Success bool               `json:"success"`
		Message string             `json:"message"`
	}
	ProjectAvatar {
		Id        string `json:"id"`
		Project   string `json:"project"`
		ProfileId string `json:"profileId"`
