type (
	MtrProxyNextTrainReq {
		Line string `form:"line"`
		Sta  string `form:"sta"`
		Lang string `form:"lang,default=zh"`
	}
	MtrProxyNextTrainPayload {
		Availability string `json:"availability"`
		Car          string `json:"car"`
	}
	MtrProxyNextTrainUpDown {
		Seq      string                     `json:"seq"`
		Dest     string                     `json:"dest"`
		Plat     string                     `json:"plat"`
		Time     string                     `json:"time"`
		Ttnt     string                     `json:"ttnt"`
		Valid    string                     `json:"valid"`
		Source   string                     `json:"source"`
		Route    string                     `json:"route"`
		TimeType string                     `json:"timeType"`
		PaxLoad  []MtrProxyNextTrainPayload `json:"paxLoad,omitempty"`
		Length   string                     `json:"length"`
	}
	MtrProxyNextTrain {
		CurrTime         string                    `json:"curr_time"`
		SysTime          string                    `json:"sys_time"`
		IsPaxLoadEnabled string                    `json:"isPaxLoadEnabled"`
		UP               []MtrProxyNextTrainUpDown `json:"UP"`
		DOWN             []MtrProxyNextTrainUpDown `json:"DOWN"`
	}
	MtrProxyNextTrainResp {
		SysTime    string                       `json:"sys_time"`
		CurrTime   string                       `json:"curr_time"`
		Data       map[string]MtrProxyNextTrain `json:"data"` // key is line-station code e.g. 'EAL-SHT'
		ResultCode int                          `json:"resultCode"`
		Timestamp  string                       `json:"timestamp"`
		Status     int                          `json:"status"`
		Message    string                       `json:"message"`
	}
	MtrProxyCreateNotificationSelection {
		Station  string `json:"station"`
		Location string `json:"location"`
		Email    string `json:"email"`
	}
	MtrProxyCreateNotificationReq {
		Action    string                                `json:"action"`
		Level     int                                   `json:"level"`
		Title     string                                `json:"title"`
		Content   string                                `json:"content"`
		Source    string                                `json:"source"`
		Function  []string                              `json:"function"`
		Selection []MtrProxyCreateNotificationSelection `json:"selection"`
		Time      string                                `json:"time"`
	}
	MtrProxyCreateNotificationResp {
		ReturnCode int    `json:"returnCode"`
		NotiId     string `json:"notiId"`
		Message    string `json:"message"`
	}
	MtrProxyDeleteNotificationReq {
		Action string `json:"action"`
		NotiId string `json:"notiId"`
		Time   string `json:"time"`
	}
	MtrProxyDeleteNotificationResp {
		ReturnCode int    `json:"returnCode"`
		Message    string `json:"message"`
	}
	MtrMailAlertReq {
		Subject string `json:"subject"`
		Content string `json:"content"`
	}
	MtrMailAlertResp {
		ReturnCode int    `json:"returnCode"`
		Message    string `json:"message"`
	}
	MtrTtpHrRouteResp {
		ErrorCode            string             `json:"errorCode"`
		ErrorMsg             string             `json:"errorMsg"`
		StationOpeningHours  string             `json:"stationOpeningHours"`
		FirstTrain           MtrTtpHrRouteTrain `json:"firstTrain"`
		LastTrain            MtrTtpHrRouteTrain `json:"lastTrain"`
		FirstLastTrainRemark string             `json:"firstLastTrainRemark"`
		Tnc                  string             `json:"tnc"`
		Routes               []HRRouteDto       `json:"routes"`
	}
	MtrTtpHrRouteTrain {
		Time        string      `json:"time"`
		Interchange interface{} `json:"interchange"`
		Links       []string    `json:"links"`
	}
	MtrTtpHrRouteReq {
		O    string `form:"o"`
		D    string `form:"d"`
		Lang string `form:"lang"`
	}
	MtrTtpLrRouteResp {
		ErrorCode            int                        `json:"errorCode"`
		ErrorMsg             string                     `json:"errorMsg"`
		Fares                HRRouteMessageFareClassDto `json:"fares"`
		FirstTrain           MtrTtpLrTrain              `json:"firstTrain"`
		LastTrain            MtrTtpLrTrain              `json:"lastTrain"`
		FirstLastTrainRemark string                     `json:"firstLastTrainRemark"`
		Tnc                  string                     `json:"tnc"`
		Routes               []LRRouteDto               `json:"routes"`
	}
	MtrTtpLrTrain {
		Time string              `json:"time"`
		Path []MtrTtpLrTrainPath `json:"path"`
	}
	MtrTtpLrTrainPath {
		ID       string `json:"ID"`
		Towards  string `json:"towards"`
		Platform string `json:"platform"`
		LineID   string `json:"lineID"`
	}
)

@server (
	prefix: /v1/custom/mtr-proxy
	group:  mtr_proxy
)
service web-api {
	@handler MtrProxyNextTrainHandler
	get /nexttrain (MtrProxyNextTrainReq) returns (MtrProxyNextTrainResp)

	@handler MtrProxyCreateNotificationHandler
	post /notification (MtrProxyCreateNotificationReq) returns (MtrProxyCreateNotificationResp)

	@handler MtrProxyDeleteNotificationHandler
	delete /notification (MtrProxyDeleteNotificationReq) returns (MtrProxyDeleteNotificationResp)

	@handler MtrMailAlertHandler
	post /mail_alert (MtrMailAlertReq) returns (MtrMailAlertResp)

	@handler MtrPrinterAlertHandler
	post /printer_alert (MtrMailAlertReq) returns (MtrMailAlertResp)

	@handler MtrUptimeAlertHandler
	post /uptime_alert (MtrMailAlertReq) returns (MtrMailAlertResp)

	@handler MtrTtpHrRouteHandler
	get /ttp/hr (MtrTtpHrRouteReq) returns (MtrTtpHrRouteResp)

	@handler MtrTtpLrRouteHandler
	get /ttp/lr (MtrTtpHrRouteReq) returns (MtrTtpLrRouteResp)
}

